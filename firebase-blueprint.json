{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "memories": {
      "title": "Memories",
      "description": "User long-term memory logs and thoughts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "content"]
    },
    "projects": {
      "title": "Projects",
      "description": "User projects and tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "title"]
    },
    "chat_sessions": {
      "title": "ChatSessions",
      "description": "User conversational sessions and messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles and account settings"
    },
    "/memories/{memoryId}": {
      "schema": "memories",
      "description": "User long-term memory records"
    },
    "/projects/{projectId}": {
      "schema": "projects",
      "description": "User projects and tasks"
    },
    "/chat_sessions/{sessionId}": {
      "schema": "chat_sessions",
      "description": "User conversation sessions"
    }
  }
}
