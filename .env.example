# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MANUS_API_KEY: Official API key for Manus AI autonomous agent (https://manus.im or compatible proxy)
MANUS_API_KEY="MY_MANUS_API_KEY"

# AIML_API_KEY: Unified API key from https://aimlapi.com (aggregates frontier models, Claude, DeepSeek-R1, Llama 3)
AIML_API_KEY="MY_AIML_API_KEY"

# ANTHROPIC_API_KEY: Direct Anthropic Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GMAIL SMTP CONFIGURATION (For sending real verification & reset codes)
# Sender email address
SMTP_USER="logitix.ai@gmail.com"
# 16-character Google App Password (generated in Google Account > Security > 2-Step Verification > App passwords)
SMTP_PASS=""
